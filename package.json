{
  "name": "widget-playground",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "node --experimental-strip-types --experimental-sqlite --test worker/test/*.test.mjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "db:create": "wrangler d1 create widget-playground-oauth --config worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply widget-playground-oauth --local --config worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply widget-playground-oauth --remote --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
