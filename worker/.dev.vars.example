# Public Notion Connection: Configuration > OAuth client credentials
NOTION_CLIENT_ID="your-public-notion-client-id"
NOTION_CLIENT_SECRET="your-public-notion-client-secret"
# Must exactly match a redirect URL configured in Notion Developer Portal
NOTION_REDIRECT_URI="http://localhost:8787/api/auth/notion/callback"
# 32-byte random key encoded as 64 hex characters, never commit to Git
TOKEN_ENCRYPTION_KEY="replace_with_64_hex_characters"
# Must be the actual browser origin + optional app path; no #fragment
FRONTEND_URL="http://localhost:5173/"
