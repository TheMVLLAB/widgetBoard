# Copy this file to .dev.vars locally. NEVER commit .dev.vars.
NOTION_TOKEN="secret_your_notion_internal_connection_token"
# Allow only explicit data source IDs. Public embed URLs reference aliases, NOT raw IDs.
NOTION_SOURCES_JSON='{"study":"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"}'
# Use separate 64-character random hexadecimal strings for each key (openssl rand -hex 32).
ADMIN_ACCESS_KEY="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
SESSION_SECRET="REPLACE_WITH_ANOTHER_64_RANDOM_HEX_CHARACTERS"
SITE_ORIGIN="http://localhost:5173,https://YOUR_NAME.github.io"
