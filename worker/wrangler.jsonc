{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "widget-playground-notion",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "widget-playground-oauth",
    "database_id": "00f66ed8-ba60-4fc7-95ce-d4d70976501c",
    "migrations_dir": "migrations"
  }],
  "secrets": {
    "required": ["NOTION_CLIENT_ID", "NOTION_CLIENT_SECRET", "NOTION_REDIRECT_URI", "TOKEN_ENCRYPTION_KEY", "FRONTEND_URL"]
  }
}
