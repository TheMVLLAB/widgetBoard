{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "widget-playground-notion",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-12",
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "widgetboard",
			"database_id": "3c8531dd-5c42-468f-b31a-5d2cf0f15217",
			"remote": true
		}
	],
	"secrets": {
		"required": [
			"NOTION_CLIENT_ID",
			"NOTION_CLIENT_SECRET",
			"NOTION_REDIRECT_URI",
			"TOKEN_ENCRYPTION_KEY",
			"FRONTEND_URL"
		]
	}
}